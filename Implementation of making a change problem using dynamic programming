
#include <iostream>
#include <climits>
using namespace std;

int main()
{
    int coins[] = {1, 2, 5, 10};
    int n = 4;

    int amount;

    cout << "Enter amount: ";
    cin >> amount;

    int dp[100];

    dp[0] = 0;

    // Initialize DP array
    for (int i = 1; i <= amount; i++)
    {
        dp[i] = INT_MAX;
    }

    // Calculate minimum coins
    for (int i = 1; i <= amount; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (coins[j] <= i &&
                dp[i - coins[j]] != INT_MAX)
            {
                dp[i] = min(dp[i],
                            1 + dp[i - coins[j]]);
            }
        }
    }

    if (dp[amount] == INT_MAX)
    {
        cout << "Change not possible";
    }
    else
    {
        cout << "Minimum coins required = "
             << dp[amount];
    }

    return 0;
}
